# ── Auth ──────────────────────────────────────────────────────────────
# 32+ random characters; signs every session cookie. Rotating it signs everyone out.
AUTH_SECRET=

# ── Google Workspace SSO (student + teacher sign-in) ──────────────────
# OAuth 2.0 "Web application" client from Google Cloud Console. The redirect
# URI is derived automatically: ${UNIFIED_HOST}/api/auth/google/callback —
# register that exact URL in the Cloud console (prod + http://localhost:4173).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev/break-glass only: keeps the passwordless email login working. In
# production leave this UNSET so everyone must use Google (or /admin/login).
ALLOW_EMAIL_LOGIN=

# ── Hosts (no protocol) ───────────────────────────────────────────────
# Unified mode: ONE hostname serving everything — the sign-in page at /,
# the student portal at /student/<id>, staff at /staff/<id>, management at
# /admin. Production: library.thelangschool.org. Local dev: localhost:4173.
UNIFIED_HOST=localhost:4173
# Legacy dual-host mode (still works alongside unified during a transition):
# the two site hostnames (vercel.app aliases or school subdomains).
# Local dev:  student.localhost:4173 / staff.localhost:4173
STUDENT_HOST=student.localhost:4173
STAFF_HOST=staff.localhost:4173

# ── Supabase (server-side only; never exposed to the browser) ─────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Gmail SMTP — no DNS needed) ────────────────────────────────
# Sends AS this mailbox through smtp.gmail.com. On the account: enable
# 2-Step Verification, then create an App password (myaccount.google.com/apppasswords).
GMAIL_USER=library@thelangschool.org
GMAIL_APP_PASSWORD=
# Optional: reroute ALL outgoing mail to one inbox (testing / dry runs):
EMAIL_OVERRIDE_TO=

# ── Cron ──────────────────────────────────────────────────────────────
# Bearer token protecting /api/cron/daily
CRON_SECRET=

# ── Push notifications (app updates) ──────────────────────────────────
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Staging only — NEVER set any of these in production ───────────────
# Secret key unlocking the reviewer entrance at /preview (no-sign-in role
# switcher using synthetic test accounts). Unset ⇒ /preview + /api/preview 404
# and the preview admin bypass in lib/guards.ts is dead code.
PREVIEW_KEY=
# Subpath staging (see lib/base.ts): serve the whole app under a prefix, e.g.
# /new2. Set BOTH to the SAME value — APP_BASE_PATH feeds next.config basePath
# (server/build), NEXT_PUBLIC_BASE_PATH is inlined into the client bundle.
APP_BASE_PATH=
NEXT_PUBLIC_BASE_PATH=
